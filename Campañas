<!-- DEMO INTERACTIVA -->
<section class="demo-section">
  <div class="section-eyebrow" style="--accent:var(--green)">
    <div class="ey-line" style="background:var(--green)"></div>
    <span class="ey-text" style="color:var(--green)">Demo interactiva</span>
  </div>
  <h2 class="section-title" style="color:var(--cream)">Así funciona el <strong>flujo en tiempo real</strong></h2>
  <p style="color:rgba(244,240,232,0.5);font-size:0.92rem;margin-bottom:0;max-width:500px">Pulsa el botón y observa cómo Make procesa el email y distribuye los envíos por campaña automáticamente.</p>

  <div class="demo-wrapper">


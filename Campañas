<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Automatización de Campañas · Brenda Fernández</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root{--cream:#F4F0E8;--cream2:#EDE8DC;--white:#FDFBF7;--navy:#1C2B4A;--navy2:#253760;--navy3:#0F1E36;--slate:#4A5568;--muted:#7A7265;--border:#D8D2C4;--accent:#2D5FA8;--accent-light:#E8EEF8;--green:#1D9E75;--green-light:#E1F5EE}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:#1A1A1A;overflow-x:hidden}

nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1.2rem 3rem;background:rgba(244,240,232,0.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:600;color:var(--navy);text-decoration:none}
.nav-logo span{display:inline-block;width:5px;height:5px;background:var(--accent);border-radius:50%;margin-left:2px;margin-bottom:6px;vertical-align:middle}
.nav-back{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s}
.nav-back:hover{color:var(--navy)}

/* HERO */
.hero{padding:9rem 4rem 5rem;background:var(--navy3);position:relative;overflow:hidden;min-height:80vh;display:flex;flex-direction:column;justify-content:center}
.hero-bg{position:absolute;inset:0;opacity:0.05;background-image:linear-gradient(var(--cream) 1px,transparent 1px),linear-gradient(90deg,var(--cream) 1px,transparent 1px);background-size:56px 56px}
.hero-circle{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,0.04)}
.hero-content{position:relative;z-index:2;max-width:760px}
.hero-eyebrow{display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem}
.eyebrow-line{width:24px;height:1px;background:var(--green)}
.eyebrow-text{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--green);font-weight:500}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2.8rem,5vw,4.5rem);font-weight:300;color:var(--cream);line-height:1.0;margin-bottom:1.5rem}
.hero h1 strong{font-weight:600;display:block}
.hero h1 em{font-style:italic;color:rgba(244,240,232,0.45);font-size:0.6em;display:block;margin-top:0.3rem}
.hero-desc{font-size:1rem;color:rgba(244,240,232,0.6);line-height:1.9;max-width:560px;margin-bottom:2.5rem}
.hero-desc strong{color:rgba(244,240,232,0.9)}
.hero-tags{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:3rem}
.hero-tag{padding:0.3rem 0.9rem;border:1px solid rgba(29,158,117,0.4);border-radius:20px;font-size:0.72rem;color:rgba(29,158,117,0.9);background:rgba(29,158,117,0.08)}
.hero-stats{display:grid;grid-template-columns:repeat(3,auto);gap:3rem;padding-top:2.5rem;border-top:1px solid rgba(255,255,255,0.08);width:fit-content}
.stat .num{font-family:'Cormorant Garamond',serif;font-size:2.8rem;font-weight:600;color:var(--cream);line-height:1;display:block}
.stat .lbl{font-size:0.68rem;text-transform:uppercase;letter-spacing:0.12em;color:rgba(244,240,232,0.35);margin-top:0.2rem;display:block}

/* SECCIONES */
.section{padding:5rem 4rem}
.section-alt{background:var(--white)}
.section-eyebrow{display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem}
.ey-line{width:20px;height:1px;background:var(--accent)}
.ey-text{font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);font-weight:500}
h2.section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(1.8rem,3vw,2.8rem);font-weight:300;color:var(--navy);margin-bottom:1.5rem;line-height:1.1}
h2.section-title strong{font-weight:600}

/* DEMO SECTION */
.demo-section{background:var(--navy3);padding:5rem 4rem}
.demo-section h2{color:var(--cream)}
.demo-wrapper{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:2.5rem;margin-top:2rem}

/* FLUJO VISUAL */
.flow-visual{display:flex;align-items:center;gap:0;margin-bottom:2.5rem;overflow-x:auto;padding-bottom:8px}
.flow-node{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:90px;opacity:0.35;transition:opacity 0.4s,transform 0.3s}
.flow-node.active{opacity:1;transform:translateY(-4px)}
.flow-node.done{opacity:1}
.flow-icon{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;border:1.5px solid rgba(255,255,255,0.1);transition:border-color 0.4s,box-shadow 0.4s}
.flow-node.active .flow-icon{border-color:var(--green);box-shadow:0 0 0 4px rgba(29,158,117,0.15)}
.flow-label{font-size:10px;color:rgba(244,240,232,0.6);text-align:center;line-height:1.3;font-weight:500}
.flow-sublabel{font-size:9px;color:rgba(244,240,232,0.3);text-align:center}
.flow-arrow{color:rgba(255,255,255,0.2);font-size:18px;margin:0 4px;flex-shrink:0;padding-bottom:24px;transition:color 0.4s}
.flow-arrow.active{color:var(--green)}

/* ESTADO DE LA DEMO */
.demo-status{min-height:40px;display:flex;align-items:center;gap:10px;margin-bottom:1.5rem}
.status-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:20px;font-size:12px;color:rgba(244,240,232,0.6);transition:all 0.3s}
.status-badge.running{border-color:rgba(29,158,117,0.4);color:rgba(29,158,117,0.9);background:rgba(29,158,117,0.08)}
.status-pulse{width:6px;height:6px;border-radius:50%;background:currentColor;animation:blink 1.2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.3}}

/* RUTAS */
.routes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:1.5rem}
.route-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:1.25rem;opacity:0.3;transition:opacity 0.5s,border-color 0.5s}
.route-card.active{opacity:1;border-color:rgba(255,255,255,0.15)}
.route-header{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.route-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.route-name{font-size:13px;font-weight:500;color:rgba(244,240,232,0.9)}
.route-desc{font-size:11px;color:rgba(244,240,232,0.4);margin-bottom:10px;line-height:1.4}
.progress-bar{height:3px;background:rgba(255,255,255,0.07);border-radius:2px;overflow:hidden;margin-bottom:8px}
.progress-fill{height:100%;border-radius:2px;width:0%;transition:width 1.4s ease}
.route-result{display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(244,240,232,0.4);opacity:0;transition:opacity 0.4s}
.route-result.visible{opacity:1;color:rgba(29,158,117,0.9)}
.check{width:16px;height:16px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;font-size:10px;color:white;flex-shrink:0}

/* RESULTADO FINAL */
.demo-result{display:none;padding:1.25rem 1.5rem;background:rgba(29,158,117,0.08);border:1px solid rgba(29,158,117,0.25);border-radius:8px;margin-top:0.5rem}
.demo-result-row{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.demo-result-icon{font-size:20px}
.demo-result-title{font-size:13px;font-weight:500;color:rgba(29,158,117,0.95)}
.demo-result p{font-size:12px;color:rgba(244,240,232,0.5);line-height:1.6;margin-left:30px}

/* BTN */
.btn-demo{display:inline-flex;align-items:center;gap:8px;padding:11px 24px;background:var(--green);color:white;border:none;border-radius:6px;font-size:13px;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;transition:background 0.2s,transform 0.15s}
.btn-demo:hover{background:#0F6E56}
.btn-demo:active{transform:scale(0.97)}
.btn-demo:disabled{background:rgba(255,255,255,0.1);cursor:not-allowed}

/* CÓMO FUNCIONA */
.steps-list{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:2rem}
.step-card{display:flex;gap:1rem;padding:1.5rem;background:var(--cream2);border-radius:4px;border:1px solid var(--border)}
.step-num-badge{width:36px;height:36px;border-radius:50%;background:var(--navy);color:var(--cream);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-size:1rem;font-weight:600;flex-shrink:0}
.step-card h3{font-size:0.88rem;font-weight:500;color:var(--navy);margin-bottom:0.35rem}
.step-card p{font-size:0.82rem;color:var(--slate);line-height:1.65}

/* IMPACTO */
.impact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-top:2rem}
.impact-card{padding:2rem 1.5rem;border-radius:4px;text-align:center}
.impact-card.green-bg{background:var(--green-light);border:1px solid rgba(29,158,117,0.2)}
.impact-card.navy-bg{background:var(--navy);border:1px solid var(--navy)}
.impact-num{font-family:'Cormorant Garamond',serif;font-size:3rem;font-weight:600;line-height:1;display:block;margin-bottom:0.5rem}
.impact-card.green-bg .impact-num{color:var(--green)}
.impact-card.navy-bg .impact-num{color:var(--cream)}
.impact-lbl{font-size:0.82rem;font-weight:500}
.impact-card.green-bg .impact-lbl{color:#085041}
.impact-card.navy-bg .impact-lbl{color:rgba(244,240,232,0.7)}
.impact-desc{font-size:0.75rem;margin-top:0.4rem;line-height:1.5}
.impact-card.green-bg .impact-desc{color:#0F6E56}
.impact-card.navy-bg .impact-desc{color:rgba(244,240,232,0.4)}

/* TECH */
.tech-row{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.5rem}
.tech-pill{display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1.1rem;background:var(--navy);color:var(--cream);border-radius:3px;font-size:0.78rem;font-weight:500}
.tech-dot{width:6px;height:6px;border-radius:50%;background:var(--green)}

/* CTA */
.cta-section{background:var(--navy);padding:4rem;text-align:center}
.cta-section h2{font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:300;color:var(--cream);margin-bottom:1rem}
.cta-section p{color:rgba(244,240,232,0.55);max-width:480px;margin:0 auto 2rem;font-size:0.95rem}
.cta-btn{display:inline-flex;align-items:center;gap:0.5rem;padding:0.9rem 2rem;background:var(--green);color:white;text-decoration:none;border-radius:3px;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;transition:background 0.2s}
.cta-btn:hover{background:#0F6E56}
.cta-link{display:inline-flex;align-items:center;gap:0.5rem;margin-left:1.5rem;font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(244,240,232,0.4);text-decoration:none;transition:color 0.2s}
.cta-link:hover{color:var(--cream)}

.reveal{opacity:0;transform:translateY(24px);transition:opacity 0.6s ease,transform 0.6s ease}
.reveal.visible{opacity:1;transform:none}

@media(max-width:1024px){
  .hero{padding:7rem 1.5rem 4rem}
  .hero-stats{gap:2rem}
  .section{padding:3rem 1.5rem}
  .demo-section{padding:3rem 1.5rem}
  .steps-list{grid-template-columns:1fr}
  .impact-grid{grid-template-columns:1fr}
  .routes-grid{grid-template-columns:1fr}
  nav{padding:1rem 1.5rem}
}
@media(max-width:640px){
  .hero-stats{grid-template-columns:repeat(2,auto);gap:1.5rem}
  .flow-visual{gap:0}
  .flow-icon{width:44px;height:44px;font-size:18px}
  .cta-section{padding:2.5rem 1.25rem}
  nav{padding:0.9rem 1.25rem}
  .nav-back span{display:none}
}
</style>
</head>

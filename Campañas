        <div class="flow-icon" style="background:rgba(234,67,53,0.12)">📎</div>
        <div class="flow-label">Gmail</div>
        <div class="flow-sublabel">Adjuntos</div>
      </div>
      <div class="flow-arrow" id="fa1">›</div>
      <div class="flow-node" id="fn2">
        <div class="flow-icon" style="background:rgba(16,185,129,0.15)">⇄</div>
        <div class="flow-label">Router</div>
        <div class="flow-sublabel">3 rutas</div>
      </div>
      <div class="flow-arrow" id="fa2">›</div>
      <div class="flow-node" id="fn3">
        <div class="flow-icon" style="background:rgba(29,111,66,0.2)">▦</div>
        <div class="flow-label">Google Sheets</div>
        <div class="flow-sublabel">Filtra clientes</div>
      </div>
      <div class="flow-arrow" id="fa3">›</div>
      <div class="flow-node" id="fn4">
        <div class="flow-icon" style="background:rgba(29,111,66,0.2)">→≡</div>

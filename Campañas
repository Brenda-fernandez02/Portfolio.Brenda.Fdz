<script>
const obs = new IntersectionObserver(e => e.forEach(r => {
  if(r.isIntersecting){r.target.classList.add('visible');obs.unobserve(r.target)}
}),{threshold:0.08});
document.querySelectorAll('.reveal').forEach(r => obs.observe(r));

const flowSteps = [
  {node:'fn0',arrow:'fa0',msg:'📧 Email entrante detectado en el buzón...'},
  {node:'fn1',arrow:'fa1',msg:'📎 Extrayendo imagen adjunta de la campaña...'},
  {node:'fn2',arrow:'fa2',msg:'⇄ Router analizando campaña y abriendo rutas...'},
  {node:'fn3',arrow:'fa3',msg:'▦ Consultando Google Sheets por campaña...'},
  {node:'fn4',arrow:'fa4',msg:'→≡ Iterator recorriendo contactos interesados...'},
  {node:'fn5',arrow:'fa5',msg:'✉ Enviando emails con imagen adjunta...'},
  {node:'fn6',arrow:null, msg:'✓ Actualizando Google Sheets — envíos registrados'}
];

let running = false;
function sleep(ms){return new Promise(r=>setTimeout(r,ms))}

async function runDemo(){
  if(running) return;
  running = true;
  const btn = document.getElementById('demoBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Ejecutando...';

  // Reset
  document.getElementById('demoResult').style.display = 'none';
  document.getElementById('timerTxt').textContent = '';
  ['rc0','rc1','rc2'].forEach(id => document.getElementById(id).classList.remove('active'));
  ['rp0','rp1','rp2'].forEach(id => {document.getElementById(id).style.width='0%'});
  ['rr0','rr1','rr2'].forEach(id => document.getElementById(id).classList.remove('visible'));
  flowSteps.forEach(s => {
    document.getElementById(s.node).classList.remove('active','done');
    if(s.arrow) document.getElementById(s.arrow).classList.remove('active');
  });

  const badge = document.getElementById('statusBadge');
  const start = Date.now();

  for(let i=0; i<flowSteps.length; i++){
    const s = flowSteps[i];
    badge.className = 'status-badge running';
    badge.innerHTML = `<span class="status-pulse"></span><span>${s.msg}</span>`;
    document.getElementById(s.node).classList.add('active');
    if(s.arrow) document.getElementById(s.arrow).classList.add('active');

    if(i===2){
      await sleep(600);
      ['rc0','rc1','rc2'].forEach((id,j) => {
        setTimeout(()=>document.getElementById(id).classList.add('active'), j*200);
      });
      ['rp0','rp1','rp2'].forEach((id,j) => {
        setTimeout(()=>{document.getElementById(id).style.width='100%'}, j*300+400);
      });
    }
    if(i===5){
      await sleep(800);
      ['rr0','rr1','rr2'].forEach((id,j) => {
        setTimeout(()=>document.getElementById(id).classList.add('visible'), j*400);
      });
    }

    document.getElementById(s.node).classList.add('done');
    await sleep(i===2?1600:900);
  }

  const elapsed = ((Date.now()-start)/1000).toFixed(1);
  document.getElementById('timerTxt').textContent = `Flujo completado en ${elapsed}s`;
  badge.className = 'status-badge running';
  badge.innerHTML = '<span class="status-pulse"></span><span>✅ Completado — 0 intervenciones manuales</span>';
  document.getElementById('demoResult').style.display = 'block';

  btn.disabled = false;
  btn.textContent = '↺ Repetir demo';
  running = false;
}
</script>
